{
  "name": "cto-route-finder-frontend",
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "predev": "node scripts/check-backend.js",
    "dev": "concurrently -n \"FRONTEND,BACKEND\" -c \"cyan,magenta\" \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:frontend": "vite dev",
    "dev:backend": "node scripts/start-backend.js",
    "build": "node ./scripts/build-prod.mjs",
    "preview": "vite preview",
    "start": "serve -s dist -l tcp://0.0.0.0:${PORT:-3000}",
    "postinstall": "echo 'Dependencies installed successfully'",
    "build:prod": "node ./scripts/build-prod.mjs"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.0.0",
    "concurrently": "^8.2.2",
    "svelte": "^4.2.7",
    "vite": "^5.0.0"
  },
  "dependencies": {
    "@googlemaps/js-api-loader": "^1.16.2",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "pdfjs-dist": "^4.10.38",
    "serve": "^14.2.0",
    "xlsx": "^0.18.5"
  }
}
