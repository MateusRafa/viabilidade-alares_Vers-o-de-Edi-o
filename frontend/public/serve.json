{
  "cleanUrls": false,
  "directoryListing": false,
  "rewrites": [
    { "source": "/embed", "destination": "/embed.html" }
  ],
  "headers": [
    {
      "source": "**",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors *"
        }
      ]
    }
  ]
}
